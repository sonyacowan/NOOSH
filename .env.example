# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Supabase: Dashboard -> Project Settings -> API (or "Connect")
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The publishable key (sb_publishable_...) or the legacy "anon" key. Safe to expose: RLS protects data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Anthropic: console.anthropic.com -> API Keys. SECRET: server only, no NEXT_PUBLIC_ prefix.
ANTHROPIC_API_KEY=sk-ant-xxx
