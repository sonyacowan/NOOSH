# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Supabase: Dashboard -> Project Settings -> API (or the "Connect" button)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The publishable key (sb_publishable_...) or the legacy "anon" key. Safe to expose: RLS protects data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# AI: set ONE of these. Secret, server only (no NEXT_PUBLIC_ prefix).
# Google Gemini (free tier): aistudio.google.com -> Get API key
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest        # optional override

# Anthropic Claude: console.anthropic.com -> API Keys
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5        # optional; default is claude-opus-5-5

# Instacart "Shop ingredients" button (optional). Key from the Instacart Developer Dashboard. SECRET.
# INSTACART_API_KEY=keys.xxxxxxxx
# INSTACART_ENV=production        # only once Instacart approves a production key; otherwise the test server is used
# NEXT_PUBLIC_INSTACART=on        # shows the button
